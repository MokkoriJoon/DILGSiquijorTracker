# Environment Variables
# Copy this file to .env and fill in your values

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Database (if using direct PostgreSQL connection)
DATABASE_URL=postgresql://user:password@localhost:5432/dilg_tracker

# Email Service (for production notifications)
SENDGRID_API_KEY=your-sendgrid-api-key
EMAIL_FROM=noreply@dilg-tracker.gov.ph

# File Storage
VITE_STORAGE_BUCKET=task-outputs
VITE_MAX_FILE_SIZE=10485760

# App Configuration
VITE_APP_NAME=DILG Task Tracker
VITE_APP_URL=http://localhost:5173
